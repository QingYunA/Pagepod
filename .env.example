# -----------------------------------------------------------------------------
# HTML Manager Environment Configuration (Dual-Mode: Cloud SaaS / Self-hosted)
# -----------------------------------------------------------------------------

# 1. 运行模式设置 ('selfhost' 单机自建版 | 'cloud' 商业多租户 SaaS 版)
NEXT_PUBLIC_APP_MODE=selfhost

# 2. 自建版管理员密码 (单机免配置默认密码，也作为 API 访问 Bearer Token)
ADMIN_PASSWORD=your-secure-admin-password

# 3. 数据库连接串 (支持 Supabase PostgreSQL、Neon、Vercel Postgres)
# 本地开发时若留空，系统自动走零配置轻量持久化 (.data/db.json)
DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# 4. Supabase Auth 认证 (当在 Cloud 模式下提供多租户注册登录)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# 5. 对象存储配置 (推荐方案: Cloudflare R2，永久免出网流量费，支持大文件直传)
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=html-manager
#
# ⚠️ 使用 R2 时必须在存储桶 Settings → CORS Policy 配置 CORS，
#    否则浏览器的加密直传 (E2EE) 会因预检 403 失败。规则示例：
#    [{"AllowedOrigins":["https://你的域名"],"AllowedMethods":["PUT","GET","HEAD"],
#      "AllowedHeaders":["*"],"ExposeHeaders":["ETag"],"MaxAgeSeconds":3600}]

# 备用对象存储: Vercel Blob (一键部署默认提供，直传无需额外 CORS 配置)
# BLOB_READ_WRITE_TOKEN=

# 6. 独立子域名配置 (为项目提供 *.yourdomain.com 独享二级域名直达访问)
# NEXT_PUBLIC_APP_DOMAIN=pagepod.dev

# 7. 安全配置 (生产环境必须配置强随机密钥，否则服务启动将报错)
# SESSION_SECRET=your-random-32-byte-hex-secret-for-jwt-signing
# ADMIN_PASSWORD=your-strong-production-admin-password
# API_TOKEN=custom-api-token-for-cursor-or-agents

# 8. 网站流量分析 (Umami Analytics)
# NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://umami.daydayup.lat/script.js
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=c7ee55df-938f-4800-b6cb-18622970fe64

# 9. PayPal 支付配置 (Lifetime Deals 一次性买断收款)
# PAYPAL_MODE=sandbox # 'sandbox' 沙箱测试模式 | 'live' 生产真实收款
# NEXT_PUBLIC_PAYPAL_CLIENT_ID=your-paypal-client-id
# PAYPAL_CLIENT_ID=your-paypal-client-id
# PAYPAL_CLIENT_SECRET=your-paypal-client-secret
